POSTGRES_DB=engine_oil
POSTGRES_USER=oil
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://oil:change-me@localhost:5432/engine_oil
APP_ENV=development
LOG_LEVEL=INFO
# Research provider
RESEARCH_PROVIDER=gemini
RESEARCH_MIN_CONFIDENCE=0.80

# Matching
MATCHING_STRATEGY=deterministic

# Gemini
GEMINI_API_KEY=
# Optional comma-separated benchmark key pool; falls back to GEMINI_API_KEY.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STAGE1_TIMEOUT_SECONDS=45
GEMINI_STAGE2_TIMEOUT_SECONDS=20
GEMINI_TOTAL_TIMEOUT_SECONDS=65
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=3072

# OpenRouter fallback
OPENROUTER_API_KEY=
# Optional comma-separated benchmark key pool; falls back to OPENROUTER_API_KEY.
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_RETRIES=2
OPENROUTER_APP_NAME=SnappCarFix
OPENROUTER_APP_URL=

# OpenCode fallback
OPENCODE_COMMAND=opencode
OPENCODE_AGENT=oil-research
OPENCODE_TIMEOUT_SECONDS=90
OPENCODE_MODEL=
OPENCODE_SERVER_URL=
RESEARCH_WEB_SEARCH_ENABLED=true



# Resin
RESIN_ENABLED=true

RESIN_PROXY_URL=http://127.0.0.1:2260
RESIN_PROXY_TOKEN=...

RESIN_ADMIN_URL=http://127.0.0.1:2260
RESIN_ADMIN_TOKEN=...

RESIN_PLATFORM_NAME=OpenRouter
RESIN_PLATFORM_ID=<UUID>

RESIN_CONTROL_TIMEOUT_SECONDS=5
OPENROUTER_RESIN_ACCOUNT=openrouter-default